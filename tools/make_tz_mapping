#!/usr/bin/env python3
#
# Generate dlls/ntdll/unix/tzmap.h from the 'TZ Mapping' block of
# dlls/kernelbase/kernelbase.rgs. ntdll uses it when the prefix lacks the
# HKLM\Software\Wine\Time Zones\TZ Mapping key.
#
# Usage: tools/make_tz_mapping  (from the top of the source tree)

import re

entries = []
inside = False
with open("dlls/kernelbase/kernelbase.rgs", encoding="utf-8") as f:
    for line in f:
        if "'TZ Mapping'" in line:
            inside = True
            continue
        if not inside:
            continue
        m = re.match(r"\s*val '([^']*)' = s '([^']*)'", line)
        if m:
            entries.append((m.group(1), m.group(2)))
        elif re.match(r"\s*}", line):
            break

entries.sort()
with open("dlls/ntdll/unix/tzmap.h", "w", encoding="utf-8") as f:
    f.write("/* Automatically generated by tools/make_tz_mapping from dlls/kernelbase/kernelbase.rgs; DO NOT EDIT!! */\n\n")
    f.write("static const struct tz_mapping\n{\n    const char *unix_name;\n    const char *win_name;\n} tz_mappings[] =\n{\n")
    for unix_name, win_name in entries:
        f.write('    { "%s", "%s" },\n' % (unix_name, win_name))
    f.write("};\n")
