#!/usr/bin/env python3
#
# Generate dlls/tzres/tzres_lang.rc from the translations in po/*.po,
# so that time zone names are localized even in builds without gettext.
#
# Usage: tools/make_tzres_lang  (from the top of the source tree)

import os
import re

LANGS = {
    "ar": "LANG_ARABIC, SUBLANG_NEUTRAL",
    "bg": "LANG_BULGARIAN, SUBLANG_NEUTRAL",
    "ca": "LANG_CATALAN, SUBLANG_NEUTRAL",
    "cs": "LANG_CZECH, SUBLANG_NEUTRAL",
    "da": "LANG_DANISH, SUBLANG_NEUTRAL",
    "de": "LANG_GERMAN, SUBLANG_NEUTRAL",
    "el": "LANG_GREEK, SUBLANG_NEUTRAL",
    "es": "LANG_SPANISH, SUBLANG_NEUTRAL",
    "fa": "LANG_PERSIAN, SUBLANG_NEUTRAL",
    "fi": "LANG_FINNISH, SUBLANG_NEUTRAL",
    "fr": "LANG_FRENCH, SUBLANG_NEUTRAL",
    "he": "LANG_HEBREW, SUBLANG_NEUTRAL",
    "hi": "LANG_HINDI, SUBLANG_NEUTRAL",
    "hr": "LANG_CROATIAN, SUBLANG_NEUTRAL",
    "hu": "LANG_HUNGARIAN, SUBLANG_NEUTRAL",
    "it": "LANG_ITALIAN, SUBLANG_NEUTRAL",
    "ja": "LANG_JAPANESE, SUBLANG_NEUTRAL",
    "ka": "LANG_GEORGIAN, SUBLANG_NEUTRAL",
    "ko": "LANG_KOREAN, SUBLANG_NEUTRAL",
    "lt": "LANG_LITHUANIAN, SUBLANG_NEUTRAL",
    "ml": "LANG_MALAYALAM, SUBLANG_NEUTRAL",
    "nb_NO": "LANG_NORWEGIAN, SUBLANG_NORWEGIAN_BOKMAL",
    "nl": "LANG_DUTCH, SUBLANG_NEUTRAL",
    "or": "LANG_ORIYA, SUBLANG_NEUTRAL",
    "pa": "LANG_PUNJABI, SUBLANG_NEUTRAL",
    "pl": "LANG_POLISH, SUBLANG_NEUTRAL",
    "pt_BR": "LANG_PORTUGUESE, SUBLANG_PORTUGUESE_BRAZILIAN",
    "pt_PT": "LANG_PORTUGUESE, SUBLANG_PORTUGUESE",
    "rm": "LANG_ROMANSH, SUBLANG_NEUTRAL",
    "ro": "LANG_ROMANIAN, SUBLANG_NEUTRAL",
    "ru": "LANG_RUSSIAN, SUBLANG_NEUTRAL",
    "si": "LANG_SINHALESE, SUBLANG_NEUTRAL",
    "sk": "LANG_SLOVAK, SUBLANG_NEUTRAL",
    "sl": "LANG_SLOVENIAN, SUBLANG_NEUTRAL",
    "sr_RS@cyrillic": "LANG_SERBIAN, SUBLANG_SERBIAN_CYRILLIC",
    "sr_RS@latin": "LANG_SERBIAN, SUBLANG_SERBIAN_LATIN",
    "sv": "LANG_SWEDISH, SUBLANG_NEUTRAL",
    "ta": "LANG_TAMIL, SUBLANG_NEUTRAL",
    "te": "LANG_TELUGU, SUBLANG_NEUTRAL",
    "th": "LANG_THAI, SUBLANG_NEUTRAL",
    "tr": "LANG_TURKISH, SUBLANG_NEUTRAL",
    "uk": "LANG_UKRAINIAN, SUBLANG_NEUTRAL",
    "zh_CN": "LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED",
    "zh_TW": "LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL",
}

def unquote(s):
    return re.sub(r'\\(.)', lambda m: {"n": "\n", "t": "\t"}.get(m.group(1), m.group(1)), s)

def read_po(path):
    """Return {(msgctxt, msgid): msgstr} for non-fuzzy, translated entries."""
    entries = {}
    with open(path, encoding="utf-8") as f:
        blocks = f.read().split("\n\n")
    for block in blocks:
        fields, cur, fuzzy = {}, None, False
        for line in block.splitlines():
            if line.startswith("#,") and "fuzzy" in line:
                fuzzy = True
            elif line.startswith("#"):
                continue
            else:
                m = re.match(r'(msgctxt|msgid|msgstr) "(.*)"$', line)
                if m:
                    cur = m.group(1)
                    fields[cur] = unquote(m.group(2))
                elif line.startswith('"') and cur:
                    fields[cur] += unquote(line[1:-1])
        if fuzzy or not fields.get("msgid") or not fields.get("msgstr"):
            continue
        entries[(fields.get("msgctxt"), fields["msgid"])] = fields["msgstr"]
    return entries

def read_rc(path):
    strings = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            m = re.match(r'\s*(\d+)\s+"(.*)"\s*$', line)
            if not m:
                continue
            text = m.group(2).replace('""', '"')
            ctx = None
            mc = re.match(r'#msgctxt#([^#]*)#(.*)$', text)
            if mc:
                ctx, text = mc.group(1), mc.group(2)
            strings.append((int(m.group(1)), ctx, text))
    return strings

def quote_rc(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '""') + '"'

def main():
    strings = read_rc("dlls/tzres/tzres.rc")
    out = ["/* Automatically generated by tools/make_tzres_lang from po/*.po; DO NOT EDIT!! */",
           "/* Only used when Wine is built without gettext, see dlls/tzres/Makefile.in */",
           "",
           '#include "winresrc.h"',
           "",
           "#pragma code_page(65001)"]
    for po in sorted(LANGS):
        trans = read_po(os.path.join("po", po + ".po"))
        lines = []
        for sid, ctx, text in strings:
            tr = trans.get((ctx, text))
            if tr and tr != text:
                lines.append("  %5d %s" % (sid, quote_rc(tr)))
        if not lines:
            continue
        out += ["", "LANGUAGE %s" % LANGS[po], "", "STRINGTABLE", "{"] + lines + ["}"]
    with open("dlls/tzres/tzres_lang.rc", "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")

main()
