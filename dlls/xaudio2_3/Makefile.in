EXTRADEFS = -DXAUDIO2_VER=3
MODULE    = xaudio2_3.dll
IMPORTS   = $(FAUDIO_PE_LIBS) advapi32 ole32 user32 uuid
EXTRAINCL = $(FAUDIO_PE_CFLAGS)
PARENTSRC = ../xaudio2_7

VER_FILEDESCRIPTION_STR = "Wine XAudio2 dll"
VER_PRODUCTVERSION      = 9,25,1476,0

SOURCES = \
	xapo.c \
	xaudio_allocator.c \
	xaudio_classes.idl \
	xaudio_dll.c \
	xaudio_register.idl
