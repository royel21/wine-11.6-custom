EXTRADEFS = -DXAUDIO2_VER=7
MODULE    = xaudio2_7.dll
IMPORTS   = $(FAUDIO_PE_LIBS) advapi32 ole32 user32 uuid
EXTRAINCL = $(FAUDIO_PE_CFLAGS)

VER_FILEDESCRIPTION_STR = "Wine XAudio2 dll"
VER_PRODUCTVERSION      = 9,29,1962,0

SOURCES = \
	x3daudio.c \
	xapo.c \
	xapofx.c \
	xaudio_allocator.c \
	xaudio_classes.idl \
	xaudio_dll.c \
	xaudio_register.idl
